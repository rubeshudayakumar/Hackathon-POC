        <payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;sp_widget&gt;&lt;category/&gt;&lt;client_script&gt;&lt;![CDATA[function($scope, $uibModal, $location, $window,spUtil, $timeout) {
	var c = this;
	//intialize
	
	
	if(c.data.infoMessage) {
		spUtil.addInfoMessage(c.data.infoMessage);
		$timeout(function() {
			$("#uiNotificationContainer").find(".alert-msg").attr("tabindex",0);
			$("#uiNotificationContainer").find(".alert-msg").attr("role","group");
			$("#uiNotificationContainer").find(".alert-msg").focus();
		});
	}
	
	var parentContainerConfig = c.data.parentContainerConfig;
	if (c.data.showModal){
		if(c.data.isCSPPortal &amp;&amp; parentContainerConfig &amp;&amp; ((parentContainerConfig["parent_container_class"] == "hidden-xs" &amp;&amp; screen.width &gt;= 768) || (parentContainerConfig["parent_container_class"] == "visible-xs" &amp;&amp; screen.width &lt; 768))) {
			$scope.modalInstance = $uibModal.open({
				templateUrl: 'externalRegistrationResponseModal',
				scope: $scope, 
			});
		}
	}
	
	c.login = function () {
		$scope.modalInstance.close();
		$location.url('?id='+ c.data.login_page);
	};
	
	c.cancel = function() {
		$scope.modalInstance.close();
	};
	
	var deregisterListener;
	if(!c.data.isLoggedIn) {
		deregisterListener = $rootScope.$on('$locationChangeStart', function (event, next, current) {
			var	finalUrl = $rootScope.portal.url_suffix ;
			$window.sessionStorage.setItem('navBackUri', '/'+ finalUrl);
			deregisterListener();
		});	
	}
}]]&gt;&lt;/client_script&gt;&lt;controller_as&gt;c&lt;/controller_as&gt;&lt;css&gt;.panel-bg-white {&amp;#13;
