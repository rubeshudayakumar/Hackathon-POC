    data.ERROR = "error";
    data.SUCCESS = "success";
    data.isLoggedIn = gs.getSession().isLoggedIn();
	data.isCSPPortal = $sp.getPortalRecord().getValue("sys_id") == ExternalRegConstants.CSP_PORTAL_ID;
	data.parentContainerConfig = options.widget_parameters? JSON.parse(options.widget_parameters) : "";

    if (!data.isLoggedIn) {
        data.register_response = $sp.getParameter('register_response');
        if (data.register_response) {
            var msg_response = gs.getSession().getClientData("reg_resp_message"),
                msg_status = gs.getSession().getClientData("reg_resp_status"),
                userName = gs.getSession().getClientData("reg_user_name");
            gs.getSession().putClientData("reg_resp_message", "");
            gs.getSession().putClientData("reg_resp_status", "");

            if ((msg_status == data.SUCCESS)) {
                if (data.register_response != ExternalRegConstants.SUCESS_REGISTRATION)
                    data.infoMessage = msg_response;
                else if (!data.isCSPPortal)
                    data.infoMessage = msg_response;
            } else if (msg_status == data.ERROR)
                gs.addErrorMessage(msg_response);
            if (data.isCSPPortal &amp;&amp; (data.register_response == ExternalRegConstants.SUCESS_REGISTRATION) &amp;&amp; !gs.nil(userName)) {
                var userId = '&lt;br/&gt;&lt;b&gt;' + userName + '&lt;/b&gt;';
                data.msg = {};
                data.msg.greet = gs.getMessage('Congratulations!');
                data.msg.successText = gs.getMessage('You have successfully registered with Username: {0}', userId);
                data.msg.loginText = gs.getMessage('Please click here to login');
                data.showModal = true;
                data.login_page = $sp.getDisplayValue('login_page') || "csm_login";
                if (!data.login_page)
                    data.login_page = 'login';
            }
        }
    }


